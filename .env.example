# Обязательно: API-ключ OpenAI из организации с активными API-кредитами
OPENAI_API_KEY=

# Для актуального поиска. Без ключа обычные ответы OpenAI продолжают работать
SERPER_API_KEY=

# Модель для ответов навыка
OPENAI_MODEL=gpt-6.1-sol

# Низкое усилие рассуждения сокращает задержку; Sol не поддерживает none/minimal
OPENAI_REASONING_EFFORT=low

# Общий предел выходных токенов, включая внутренние токены рассуждения
OPENAI_MAX_OUTPUT_TOKENS=1200
